{
  "manifest_version": 3,
  "name": "JD Career Strategist",
  "version": "1.0.0",
  "description": "Reads job descriptions from the browser tabs you pick, evaluates them against your master resumes with Groq, and generates tailored one-page LaTeX resumes.",
  "permissions": ["tabs", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JD Career Strategist"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["resumes/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
